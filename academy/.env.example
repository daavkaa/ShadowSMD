# ───────────────────────── Skills Academy environment ─────────────────────────
# Copy to .env.local for local development. NEVER commit real secrets.
# Secrets marked [server] must never be exposed to the browser (no NEXT_PUBLIC_ prefix).

# local | test | staging | production. Demo payments and dev auth are REFUSED in production.
APP_STAGE=local
APP_URL=http://localhost:3000

# [server] Postgres connection used by the backend. Local: the throwaway cluster from
# `npm run db:local:start`. Supabase: Project Settings → Database → connection string
# (use the pooler in transaction mode for serverless; prepared statements are disabled).
DATABASE_URL=postgres://postgres@127.0.0.1:54329/academy

# supabase (production) | dev (local/test only — signed cookie, no password)
AUTH_MODE=dev
# [server] min 32 chars, only for AUTH_MODE=dev
DEV_AUTH_SECRET=change-me-local-dev-secret-at-least-32-chars

# Supabase Auth (public values; required when AUTH_MODE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# demo (local/test only) | qpay
PAYMENT_PROVIDER=demo
# [server] HMAC secret for the demo provider webhook (min 32 chars)
DEMO_WEBHOOK_SECRET=change-me-demo-webhook-secret-at-least-32

# [server] QPay Merchant v2 — UNVERIFIED adapter; see docs/runbooks/qpay-sandbox.md
QPAY_BASE_URL=
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_SECRET=
# Set to true only after the sandbox contract test passes.
QPAY_CONTRACT_VERIFIED=false

# [server] Bearer secret for /api/cron/reconcile (min 32 chars)
CRON_SECRET=change-me-cron-secret-at-least-32-characters

CREDENTIAL_ISSUER_NAME=Skills Academy
